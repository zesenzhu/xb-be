// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

// ==========================================
// 1. 用户与权限模块 (RBAC)
// ==========================================

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // 采用 bcrypt 哈希加密存储
  nickname  String?
  email     String?
  avatar    String?
  status    Int      @default(1) // 1: 启用, 0: 禁用
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sys_user")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique // 例如: ADMIN (超级管理员), OPERATOR (运营)
  description String?
  users       User[]
  permissions Permission[] @relation("RoleToPermission")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("sys_role")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   // 权限名称，如 "生成注册码"
  code        String   @unique // 权限标识，如 "regcode:create"
  description String?
  roles       Role[]   @relation("RoleToPermission")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sys_permission")
}

// ==========================================
// 2. 注册码授权管理模块
// ==========================================

model RegisterCode {
  id              String      @id @default(uuid())
  code            String      @unique // 注册码文本
  source          String      @default("CREATE") // 激活码来源，"CREATE" 为自建，"IMPORT" 为导入
  appName         String?     @map("app_name") // 绑定的应用名称；为 null 表示“通用型注册码”
  cardType        String      @default("YK") @map("card_type") // 卡片种类，例如: WK(周卡), YK(月卡), NK(年卡), YJ(永久卡)
  durationMinutes Int         @default(43200) @map("duration_minutes") // 该卡初始有效时长 (分钟)，默认 30 天
  
  activatedAt     DateTime?   @map("activated_at") // 首次激活时间 (首次登录时写入)
  expireTime      DateTime?   @map("expire_time") // 有效期截止时间 (激活后计算)
  
  maxActive       Int         @default(1) @map("max_active") // 该卡最大允许同时绑定的设备数
  usedNum         Int         @default(0) @map("used_num") // 当前已绑定的设备数
  status          Int         @default(1) // 状态：1-正常可用/未激活，2-使用中，0-禁用，3-已过期，4-设备数已满
  
  // 绑定设备详情：存储设备ID、激活时间、IP等。
  // 格式如：[{"deviceId": "DEV001", "activatedAt": "2026-06-02T12:00:00Z"}]
  bindDevices     Json        @default("[]") @map("bind_devices")
  
  // 物理设备绑定关系
  boundDevices    RegisterCodeDevice[]
  
  // 权限细分：该卡允许客户端调用哪些 API 接口或脚本功能
  // 格式如：["script:run", "api:data:fetch"]
  allowedApis     Json        @default("[]") @map("allowed_apis")
  
  remark          String?     // 管理员备注
  
  logs            ScriptLog[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("register_code")
}

// ==========================================
// 2.1 注册码物理设备绑定白名单
// ==========================================

model RegisterCodeDevice {
  id             String        @id @default(uuid())
  registerCodeId String        @map("register_code_id")
  deviceId       String        @map("device_id")
  boundAt        DateTime      @default(now()) @map("bound_at")
  
  registerCode   RegisterCode  @relation(fields: [registerCodeId], references: [id], onDelete: Cascade)

  @@unique([registerCodeId, deviceId])
  @@index([deviceId])
  @@map("register_code_device")
}

// ==========================================
// 3. 客户端脚本运行日志模块
// ==========================================

model ScriptLog {
  id             String        @id @default(uuid())
  deviceId       String        @map("device_id") // 上报的设备唯一标识
  registerCodeId String?       @map("register_code_id") // 关联的注册码，支持级联
  registerCode   RegisterCode? @relation(fields: [registerCodeId], references: [id], onDelete: SetNull)
  level          String        // 日志级别: INFO, WARN, ERROR, DEBUG
  message        String        @db.Text // 具体的日志文本内容
  
  // 结构化上下文：如报错时的异常堆栈、自定义业务变量参数等
  extraData      Json?         @map("extra_data")
  
  // 日志产生时间（由客户端上报时携带，或者落库时自动生成）
  timestamp      DateTime      @default(now())

  // 索引设计：优化日志检索与高频查询
  @@index([deviceId])
  @@index([registerCodeId])
  @@index([timestamp])
  @@map("script_log")
}

// ==========================================
// 4. AI Agent 服务配置模块
// ==========================================

model AiAgentConfig {
  id           String   @id @default(uuid())
  name         String   @unique // Agent 名称，例如 "自动化脚本助手"
  model        String   // 使用的大模型名，例如 "deepseek-chat", "gpt-4o"
  systemPrompt String   @db.Text @map("system_prompt") // 系统设定/Prompt
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(2048) @map("max_tokens")
  
  // 函数调用(Function Calling)/Tools 定义列表
  // 格式如：[{"type": "function", "function": { "name": "reboot_device", ... }}]
  tools        Json     @default("[]")
  
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("ai_agent_config")
}

model RegisterCodeLog {
  id          String   @id @default(uuid())
  code        String   // 注册码卡密文本
  actionType  String   @map("action_type") // 操作类型：GENERATE, ADJUST, ENABLE, DISABLE, UNBIND, DELETE
  description String   @db.Text // 详细变更描述
  operator    String   @default("admin") // 操作管理员
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([code])
  @@index([createdAt])
  @@map("register_code_log")
}

// ==========================================
// 5. 系统设置与动态变量管理
// ==========================================

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique // 例如: "mail_enabled", "smtp_host", "smtp_port", "smtp_user", "smtp_pass", "smtp_from"
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sys_setting")
}

model EmailVerifyCode {
  id         String   @id @default(uuid())
  email      String   // 目标邮箱
  code       String   // 验证码字符 (6位数字)
  used       Boolean  @default(false)
  expireTime DateTime @map("expire_time")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("sys_email_verify_code")
  @@index([email])
}

